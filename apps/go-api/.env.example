# UploadRelay Go API / Worker environment
# Copy to .env and fill in real values: cp .env.example .env
# Loaded by godotenv for both `cmd/server` and `cmd/worker`.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HTTP port for the API server (http://localhost:PORT)
PORT=8080
# Runtime environment, e.g. development, staging, production
ENV=development
# Base URL of the Next.js web app (used for OAuth redirects back to the UI)
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uploadrelay?sslmode=disable

# ---------------------------------------------------------------------------
# Redis / Asynq
# ---------------------------------------------------------------------------
# Redis connection URI used by the Asynq client (API) and worker
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# AWS S3 (originals + HLS previews)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=uploadrelay-dev

# ---------------------------------------------------------------------------
# Auth / encryption
# ---------------------------------------------------------------------------
# Shared HS256 secret with the web app. MUST be identical to the web app's GO_JWT_SECRET.
# Generate with: openssl rand -hex 32
GO_JWT_SECRET=replace-with-a-long-random-secret
# Base64-encoded 32-byte key used to encrypt YouTube refresh tokens (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ---------------------------------------------------------------------------
# Google / YouTube OAuth
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/youtube/oauth/callback
