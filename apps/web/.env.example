# UploadRelay web app environment
# Copy to .env.local and fill in real values: cp .env.example .env.local
# Next.js loads .env.local from this directory (apps/web).

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Same database used by the Go API/migrations. Consumed by packages/db (Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uploadrelay?sslmode=disable

# ---------------------------------------------------------------------------
# NextAuth (Credentials provider)
# ---------------------------------------------------------------------------
# Public URL of this web app
NEXTAUTH_URL=http://localhost:3000
# Session/JWT signing secret. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Go API
# ---------------------------------------------------------------------------
# Base URL of the Go API server (browser + server side requests)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Shared HS256 secret used to mint the short-lived Go API JWT.
# MUST be identical to the Go API's GO_JWT_SECRET.
GO_JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Media previews
# ---------------------------------------------------------------------------
# Public S3/CDN base URL where HLS previews are served from.
# Example: https://uploadrelay-dev.s3.us-east-1.amazonaws.com
#         or https://cdn.example.com
NEXT_PUBLIC_S3_PREVIEW_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com
